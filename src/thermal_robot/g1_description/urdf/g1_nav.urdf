<?xml version="1.0"?>
<!--
  g1_nav.urdf — Unitree G1 简化导航模型 v2 (SLAM+Nav2版)
  =========================================================
  v2 新增：
    - lidar_link + lidar_joint：虚拟2D激光雷达，挂载在机器人顶部
    - Gazebo ray sensor 插件：发布 /scan (sensor_msgs/LaserScan, 10Hz, 360°)
      slam_toolbox 直接订阅 /scan 进行建图和定位
    - 其余结构保持与 v1 完全一致（差速驱动不变）

  TF 树（接入SLAM后完整）：
    map → odom → base_link → thermal_camera
                            → lidar_link
                            → left_wheel / right_wheel
                            → front_caster / back_caster
    map → odom 由 slam_toolbox 发布
    odom → base_link 由 diff_drive 插件发布

  Ref: slam_toolbox REP-2003, Macenski 2021 arXiv:2010.10195
-->
<robot name="g1_nav">

  <!-- ══════════════════════════════════════
       BASE LINK（机器人主体圆柱）
  ══════════════════════════════════════ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.3" rpy="0 0 0"/>
      <geometry><cylinder radius="0.20" length="0.60"/></geometry>
      <material name="g1_gray"><color rgba="0.3 0.3 0.35 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.3" rpy="0 0 0"/>
      <geometry><cylinder radius="0.20" length="0.60"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.3" rpy="0 0 0"/>
      <mass value="34.0"/>
      <inertia ixx="2.18" ixy="0.0" ixz="0.0"
               iyy="2.18" iyz="0.0" izz="0.68"/>
    </inertial>
  </link>

  <!-- ══════════════════════════════════════
       WHEELS
  ══════════════════════════════════════ -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.14" length="0.06"/></geometry>
      <material name="wheel_dark"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.14" length="0.06"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0034" ixy="0.0" ixz="0.0"
               iyy="0.0034" iyz="0.0" izz="0.0049"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="left_wheel"/>
    <origin xyz="0.0 0.20 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.14" length="0.06"/></geometry>
      <material name="wheel_dark"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.14" length="0.06"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0034" ixy="0.0" ixz="0.0"
               iyy="0.0034" iyz="0.0" izz="0.0049"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="right_wheel"/>
    <origin xyz="0.0 -0.20 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>

  <!-- ══════════════════════════════════════
       CASTERS
  ══════════════════════════════════════ -->
  <link name="front_caster">
    <visual><geometry><sphere radius="0.05"/></geometry>
      <material name="caster_mat"><color rgba="0.5 0.5 0.5 1.0"/></material></visual>
    <collision>
      <geometry><sphere radius="0.05"/></geometry>
      <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
    </collision>
    <inertial><mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="front_caster"/>
    <origin xyz="0.18 0.0 -0.09" rpy="0 0 0"/>
  </joint>

  <link name="back_caster">
    <visual><geometry><sphere radius="0.05"/></geometry>
      <material name="caster_mat"><color rgba="0.5 0.5 0.5 1.0"/></material></visual>
    <collision>
      <geometry><sphere radius="0.05"/></geometry>
      <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
    </collision>
    <inertial><mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="back_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="back_caster"/>
    <origin xyz="-0.18 0.0 -0.09" rpy="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════
       THERMAL CAMERA
  ══════════════════════════════════════ -->
  <link name="thermal_camera">
    <visual>
      <geometry><box size="0.04 0.10 0.03"/></geometry>
      <material name="camera_mat"><color rgba="0.1 0.1 0.8 1.0"/></material>
    </visual>
    <collision><geometry><box size="0.04 0.10 0.03"/></geometry></collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="thermal_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="thermal_camera"/>
    <origin xyz="0.18 0.0 0.58" rpy="0 0.831 0"/>
  </joint>

  <!-- ══════════════════════════════════════
       [v2新增] LIDAR LINK — 虚拟2D激光雷达
       位置：机器人顶部中心 (z=0.65m)
       发布 /scan (LaserScan) → slam_toolbox
  ══════════════════════════════════════ -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="lidar_mat"><color rgba="0.05 0.05 0.05 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0"
               iyy="0.00005" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <!-- 激光雷达安装在机器人顶部中心，高度0.65m -->
    <origin xyz="0.0 0.0 0.65" rpy="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════
       GAZEBO PLUGINS
  ══════════════════════════════════════ -->

  <!-- 差速驱动（与v1完全一致） -->
  <gazebo>
    <plugin name="diff_drive_controller"
            filename="libgazebo_ros_diff_drive.so">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.40</wheel_separation>
      <wheel_diameter>0.28</wheel_diameter>
      <max_wheel_torque>80.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <publish_wheel_joint_state>true</publish_wheel_joint_state>
      <odometry_source>world</odometry_source>
      <update_rate>20</update_rate>
      <legacyMode>false</legacyMode>
    </plugin>
  </gazebo>

  <!-- [v2新增] 虚拟2D激光雷达插件
       输出: /scan (sensor_msgs/LaserScan)
       参数: 360°全向, 12m最大测距, 10Hz
       slam_toolbox 默认订阅 /scan -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 轮子摩擦参数（与v1完全一致） -->
  <gazebo reference="left_wheel">
    <mu1>1.5</mu1><mu2>0.5</mu2>
    <kp>1000000.0</kp><kd>10.0</kd>
    <minDepth>0.001</minDepth><maxVel>0.1</maxVel>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="right_wheel">
    <mu1>1.5</mu1><mu2>0.5</mu2>
    <kp>1000000.0</kp><kd>10.0</kd>
    <minDepth>0.001</minDepth><maxVel>0.1</maxVel>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="front_caster">
    <mu1>0.0</mu1><mu2>0.0</mu2>
    <kp>1000000.0</kp><kd>10.0</kd>
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="back_caster">
    <mu1>0.0</mu1><mu2>0.0</mu2>
    <kp>1000000.0</kp><kd>10.0</kd>
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

</robot>
