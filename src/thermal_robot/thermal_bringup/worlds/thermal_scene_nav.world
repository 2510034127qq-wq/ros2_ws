<?xml version="1.0"?>
<!--
  thermal_scene_nav.world (Fix-5)
  ================================
  Fix-5 核心修改：ODE 物理参数调整以防止 spawn 弹射

  根因：contact_max_correcting_vel=100 允许 ODE 以最高100m/s修正接触穿透，
  导致 34kg 机器人落地时受 ~4760N 冲击力，被弹射 6m+。

  修复参数（参考 gazebosim.org/tutorials?tut=physics_params）：
    contact_max_correcting_vel: 100.0 → 2.0   (★关键：限制最大修正速度)
    contact_surface_layer:      0.001 → 0.005  (增大接触层厚度，更柔和接触)
    erp:                        0.2   → 0.1    (降低位置误差恢复力)
    cfm:                        0.0   → 0.0001 (增加约束力混合，增加弹性)

  热源标记柱无碰撞体（Fix-4 已移除，保持）
  Config-B 坐标（与 sensor_node.py v13 同步）：
    heat_source_0 = SA_left(-1.0, 3.5)  amp=35 peak=57°C
    heat_source_1 = SB_far ( 6.0,-3.0)  amp=22 peak=44°C
    heat_source_2 = SC_weak(-5.0,-5.5)  amp=16 peak=38°C
-->
<sdf version="1.6">
  <world name="thermal_nav_scene">

    <!-- ★ Fix-5: 防弹射物理参数 ★ -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.0</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.0001</cfm>
          <erp>0.1</erp>
          <contact_max_correcting_vel>2.0</contact_max_correcting_vel>
          <contact_surface_layer>0.005</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.2 0.2 0.25 1</background>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 0 18 0 1.5707 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- 热源 0: SA_left(-1,3.5) A=35°C σ=1.1m peak=57°C — 纯视觉，无碰撞 [Config-B] -->
    <model name="heat_source_0">
      <static>true</static>
      <pose>-1.0 3.5 0 0 0 0</pose>
      <link name="link">
        <visual name="pillar">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>1.0</length></cylinder></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <n>Gazebo/Red</n>
          </script></material>
        </visual>
        <visual name="top_sphere">
          <pose>0 0 1.1 0 0 0</pose>
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <n>Gazebo/RedGlow</n>
          </script></material>
        </visual>
        <visual name="base">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><cylinder><radius>0.25</radius><length>0.1</length></cylinder></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <n>Gazebo/DarkRed</n>
          </script></material>
        </visual>
      </link>
    </model>

    <!-- 热源 1: SB_far(6,-3) A=22°C σ=0.9m peak=44°C — 纯视觉，无碰撞 [Config-B] -->
    <model name="heat_source_1">
      <static>true</static>
      <pose>6.0 -3.0 0 0 0 0</pose>
      <link name="link">
        <visual name="pillar">
          <pose>0 0 0.4 0 0 0</pose>
          <geometry><cylinder><radius>0.07</radius><length>0.8</length></cylinder></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <n>Gazebo/Orange</n>
          </script></material>
        </visual>
        <visual name="top_sphere">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <n>Gazebo/Yellow</n>
          </script></material>
        </visual>
        <visual name="base">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><cylinder><radius>0.20</radius><length>0.1</length></cylinder></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <n>Gazebo/DarkYellow</n>
          </script></material>
        </visual>
      </link>
    </model>

    <!-- 热源 2: SC_weak(-5,-5.5) A=16°C σ=0.8m peak=38°C — 纯视觉，无碰撞 [Config-B] -->
    <model name="heat_source_2">
      <static>true</static>
      <pose>-5.0 -5.5 0 0 0 0</pose>
      <link name="link">
        <visual name="pillar">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.6</length></cylinder></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <n>Gazebo/Yellow</n>
          </script></material>
        </visual>
        <visual name="top_sphere">
          <pose>0 0 0.7 0 0 0</pose>
          <geometry><sphere><radius>0.10</radius></sphere></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <n>Gazebo/White</n>
          </script></material>
        </visual>
        <visual name="base">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>0.1</length></cylinder></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <n>Gazebo/Grey</n>
          </script></material>
        </visual>
      </link>
    </model>

    <!-- 起始区域标记 (-6,0) — 纯视觉 -->
    <model name="robot_start_marker">
      <static>true</static>
      <pose>-6.0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="pad">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry><box><size>0.5 0.5 0.04</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <n>Gazebo/Green</n>
          </script></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
