<?xml version="1.0"?>
<sdf version="1.6">
  <world name="thermal_nav_zigzag_corridors">
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <scene>
      <ambient>0.46 0.46 0.46 1</ambient>
      <background>0.18 0.20 0.21 1</background>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 0 24 0 1.5707 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <model name="robot_start_marker">
      <static>true</static>
      <pose>-6.0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="pad">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry><box><size>0.6 0.6 0.04</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>

    <model name="zig_wall_north_west">
      <static>true</static>
      <pose>-3.0 2.6 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.2 0.24 1.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.2 0.24 1.1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <model name="zig_wall_south_mid">
      <static>true</static>
      <pose>0.3 -2.4 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.0 0.24 1.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.0 0.24 1.1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <model name="zig_wall_north_east">
      <static>true</static>
      <pose>4.2 2.1 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.4 0.24 1.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.4 0.24 1.1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <model name="zig_vertical_west">
      <static>true</static>
      <pose>-3.6 -0.2 0.55 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.4 0.24 1.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.4 0.24 1.1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
      </link>
    </model>

    <model name="zig_vertical_east">
      <static>true</static>
      <pose>2.4 0.0 0.55 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.2 0.24 1.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.2 0.24 1.1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
      </link>
    </model>

    <model name="zig_island_southwest">
      <static>true</static>
      <pose>-6.0 -3.3 0.45 0 0 0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 0.7 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5 0.7 0.9</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
      </link>
    </model>

    <model name="zig_island_east">
      <static>true</static>
      <pose>6.0 -1.3 0.45 0 0 -0.55</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.6 0.8 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.6 0.8 0.9</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>
      </link>
    </model>
  </world>
</sdf>
