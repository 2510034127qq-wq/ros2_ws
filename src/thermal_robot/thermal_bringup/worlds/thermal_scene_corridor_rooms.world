<?xml version="1.0"?>
<sdf version="1.6">
  <world name="thermal_nav_corridor_rooms">
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.0</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.0001</cfm>
          <erp>0.1</erp>
          <contact_max_correcting_vel>2.0</contact_max_correcting_vel>
          <contact_surface_layer>0.005</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <scene>
      <ambient>0.43 0.43 0.43 1</ambient>
      <background>0.16 0.18 0.22 1</background>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 0 22 0 1.5707 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <model name="robot_start_marker">
      <static>true</static>
      <pose>-6.0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="pad">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry><box><size>0.6 0.6 0.04</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Green</name>
          </script></material>
        </visual>
      </link>
    </model>

    <model name="wall_main_north">
      <static>true</static>
      <pose>0.5 2.4 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>14.0 0.25 1.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>14.0 0.25 1.1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_main_south_left">
      <static>true</static>
      <pose>-3.8 -2.4 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.2 0.25 1.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.2 0.25 1.1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_main_south_right">
      <static>true</static>
      <pose>3.6 -2.4 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.6 0.25 1.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.6 0.25 1.1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_room_north_inner">
      <static>true</static>
      <pose>-1.8 4.6 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.0 0.25 1.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.0 0.25 1.1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_room_south_inner">
      <static>true</static>
      <pose>2.4 -4.6 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.2 0.25 1.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.2 0.25 1.1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_room_left_divider">
      <static>true</static>
      <pose>-4.2 3.55 0.55 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.3 0.25 1.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.3 0.25 1.1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_room_right_divider">
      <static>true</static>
      <pose>5.1 -3.5 0.55 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.25 1.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.25 1.1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
